# Seed config for Banana Pi BPI-R2 Pro (Rockchip RK3568) + full FRR.
# Appended to .config, then expanded with `make defconfig`. The workflow fails
# if any line here doesn't survive defconfig (typo'd or renamed symbols get
# silently dropped otherwise).

# --- Target ---
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_sinovoip_bpi-r2-pro=y

# 16 GB eMMC, so no reason to keep the 104 MiB default. Python + all of FRR
# fits in the default, but this leaves room for opkg/apk installs later.
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# --- Build speed ---
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# --- Web UI (official release images ship it; source builds don't by default) ---
CONFIG_PACKAGE_luci=y

# --- FRR: core + every daemon in the feed ---
CONFIG_PACKAGE_frr=y
CONFIG_PACKAGE_frr-zebra=y
CONFIG_PACKAGE_frr-watchfrr=y
CONFIG_PACKAGE_frr-pythontools=y
CONFIG_PACKAGE_frr-babeld=y
CONFIG_PACKAGE_frr-bfdd=y
CONFIG_PACKAGE_frr-bgpd=y
CONFIG_PACKAGE_frr-eigrpd=y
CONFIG_PACKAGE_frr-fabricd=y
CONFIG_PACKAGE_frr-isisd=y
CONFIG_PACKAGE_frr-ldpd=y
CONFIG_PACKAGE_frr-nhrpd=y
CONFIG_PACKAGE_frr-ospfd=y
CONFIG_PACKAGE_frr-ospf6d=y
CONFIG_PACKAGE_frr-pathd=y
CONFIG_PACKAGE_frr-pbrd=y
CONFIG_PACKAGE_frr-pimd=y
CONFIG_PACKAGE_frr-pim6d=y
CONFIG_PACKAGE_frr-ripd=y
CONFIG_PACKAGE_frr-ripngd=y
CONFIG_PACKAGE_frr-staticd=y
CONFIG_PACKAGE_frr-vrrpd=y

# --- Kernel support FRR daemons need but the stock kernel leaves off ---
# MPLS forwarding (ldpd, MPLS labels from bgpd/isisd/ospfd SR)
CONFIG_PACKAGE_kmod-mpls=y
# VRFs (zebra/bgpd VRF support)
CONFIG_KERNEL_NET_L3_MASTER_DEV=y
CONFIG_PACKAGE_kmod-vrf=y
# GRE tunnels (nhrpd / DMVPN)
CONFIG_PACKAGE_kmod-gre=y
# Multicast routing for pimd/pim6d (already default y, pinned so it can't regress)
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y
